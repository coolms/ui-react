{
  "kit": "@coolms/ui-react",
  "components": {
    "button": { "implementedBy": "Button", "states": ["default", "primary", "danger", "disabled", "busy", "locked", "quiet"] },
    "text-field": { "implementedBy": "TextField", "states": ["default", "focused", "disabled", "read-only", "invalid", "pinned"] },
    "select": { "implementedBy": "Select", "states": ["default", "disabled", "read-only", "invalid", "empty-list"] },
    "toggle": { "implementedBy": "Toggle", "states": ["on", "off", "disabled", "read-only"] },
    "modal": { "implementedBy": "Modal", "states": ["open", "closing", "dirty"] },
    "confirm-dialog": { "implementedBy": "ConfirmDialog", "states": ["default", "danger", "discard-changes"] },
    "toast": { "implementedBy": "Toast", "states": ["success", "error", "info", "with-action"] },
    "loading": { "implementedBy": "Loading", "states": ["inline", "block"] },
    "empty-state": { "implementedBy": "EmptyState", "states": ["default", "with-action"] },
    "state": { "implementedBy": "State", "states": ["loading", "empty", "error", "denied", "page", "block", "inline", "with-action", "delayed"] },
    "error-banner": { "implementedBy": "ErrorBanner", "states": ["default", "with-retry"] },
    "page-header": { "implementedBy": "PageHeader", "states": ["default", "with-actions", "with-back-link"] },
    "section-header": { "implementedBy": "SectionHeader", "states": ["default", "with-primary", "with-primary-menu", "with-more", "action-disabled", "with-context", "full-width"] },
    "tab-strip": { "implementedBy": "TabStrip", "states": ["default", "active", "with-count"] },
    "list": { "implementedBy": "List", "states": ["loading", "empty", "populated", "selected", "error", "pulled"] },
    "avatar": { "implementedBy": "Avatar", "states": ["picture", "initials", "presence", "connection", "deleted"] },
    "filter-chips": { "implementedBy": "FilterChips", "states": ["default", "chosen", "focused", "overflowing"] },
    "screen-shell": { "implementedBy": "ScreenShell", "states": ["root", "nested", "with-filters", "with-primary-action", "with-primary-menu", "with-more", "pulling", "refreshing", "searching", "bar-hidden"] },
    "context-menu": { "implementedBy": "ContextMenu", "states": ["open", "item-danger", "item-locked", "item-refused", "item-disabled"] },
    "file-viewer": { "implementedBy": "FileViewer", "states": ["loading", "error", "no-preview", "editing", "editing-closing", "editing-conflict", "with-edit", "with-siblings", "with-thumbnails", "with-attachment-strip", "phone"] },
    "file-picker": { "implementedBy": "FilePicker", "states": ["loading", "empty", "error", "denied", "with-selection", "with-budget", "over-budget", "disabled-entry", "paging", "phone"] },
    "notification": { "implementedBy": "Notification", "states": ["unread", "read", "collapsed", "expanded", "with-action", "row-action"] },
    "pane-toolbar": { "implementedBy": "PaneToolbar", "states": ["default", "labels-partly-hidden", "labels-hidden", "overflowing", "menu-open", "with-status", "action-disabled", "action-busy", "phone"] },
    "splitter": { "implementedBy": "Splitter", "states": ["default", "hover", "dragging", "focused", "at-min", "at-max"] }
  },
  "serverStates": {
    "node-rwx": { "where": "src/server/capability.ts" },
    "action-now": { "where": "src/server/refusal.ts" },
    "elevation": { "where": "src/server/reread.ts" },
    "space-writable": { "where": "src/server/reread.ts" },
    "consent": { "where": "src/server/reread.ts" },
    "capability": { "where": "src/server/capability.ts" },
    "navi-offered": { "where": "src/server/reread.ts" },
    "versioned-write": { "where": "src/server/conflict.ts" },
    "client-version": { "where": "src/server/client-update.ts" }
  },
  "notOffered": {
    "elevation-required": "this kit's clients never elevate: an `elevate` answer is not offered at all (offerFor with elevates: false)",
    "settings-shell": "no screen of this kit's clients draws a settings layout yet: it is offered with the first one (My Profile)"
  }
}
