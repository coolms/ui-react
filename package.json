{
  "name": "@coolms/ui-react",
  "version": "0.1.0-alpha.3",
  "description": "The CoolMS UI kit for React: the components of the CoolMS UI contract, styled by the CoolMS design tokens",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/coolms/ui-react.git"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kit.css": "./src/kit.css",
    "./tokens.css": "./src/tokens/coolms-tokens.css",
    "./fonts.css": "./src/fonts/inter.css"
  },
  "files": [
    "dist",
    "src/kit.css",
    "src/tokens",
    "src/fonts",
    "kit.contract.json",
    "design-tokens.lock.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "node tools/check-kit.mjs kit.contract.json && node tools/check-kit-sources.mjs kit.contract.json",
    "tokens:check": "node tools/tokens-lock.mjs && node tools/check-css.mjs src/tokens/coolms-tokens.css && node tools/check-css-teeth.mjs && node tools/check-css-tokens.mjs && node tools/check-breakpoints.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "check:layout": "node tools/check-layout.mjs",
    "verify": "npm run tokens:check && npm run check && npm run typecheck && npm test && npm run build && npm run check:built && npm run demo:build && npm run check:layout",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "check:built": "node tools/check-built.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
